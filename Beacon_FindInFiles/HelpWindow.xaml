<Window x:Class="Beacon.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon Help" Width="960" Height="740" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Icon="/beacon_no_bg.png"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="2"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TopicBorder" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TopicBorder" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TopicBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TopicBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="How to use Beacon" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Start with your first search, or find an answer below. This guide works offline." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Search help"/><TextBox x:Name="HelpSearch_txt" AutomationProperties.Name="Search help" ToolTip="Search topic titles and descriptions, for example: one event, UTC, export, or redaction."/></StackPanel>
            <Button x:Name="ClearHelpSearch_btn" Grid.Column="1" Content="Clear" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="HelpTopics_lst" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Help topics">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="HelpTitle_txt" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox x:Name="HelpBody_txt" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0" Padding="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                             Background="{DynamicResource CardBackgroundBrush}" AutomationProperties.Name="Help topic description"/>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="DocumentationLinkRow" Visibility="Collapsed" TextWrapping="Wrap">
                            <Hyperlink x:Name="RegexDocumentation_lnk" Foreground="{DynamicResource AccentBrush}" Click="OpenDocumentation"
                                       ToolTip="Open the official Microsoft .NET regex reference in your browser (internet required).">Microsoft .NET regex documentation ↗</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="DocumentationStatus_txt" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HelpCount_txt" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="ReplayTour_btn" Grid.Column="1" Content="Replay welcome tour" Margin="0,0,8,0"
                    AutomationProperties.Name="Replay welcome tour" ToolTip="Replay the introduction without changing the once-only startup offer."/>
            <Button x:Name="CloseHelp_btn" Grid.Column="2" Content="Close" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
