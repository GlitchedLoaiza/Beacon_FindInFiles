<UserControl x:Class="BeaconFilterControls.SeveritySelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Selector" Focusable="False">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Button x:Name="OpenLevels" Content="All levels ▾" Height="34" MinWidth="0" Margin="0" Padding="8,4"
                HorizontalContentAlignment="Left" AutomationProperties.Name="Choose severity levels" Click="OpenLevels_Click"/>
        <Popup x:Name="LevelsPopup" PlacementTarget="{Binding ElementName=Selector}" Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="None">
            <Border MinWidth="230" Margin="0,4,0,0" Padding="10" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}">
                <StackPanel x:Name="LevelChoices" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="Severity levels" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="All levels" Height="28" MinWidth="0" Margin="0,4,0,4" Padding="6,2" Click="AllLevels_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
