<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <sys:Boolean x:Key="UsesAeroTheme">True</sys:Boolean>
    <sys:Double x:Key="ActionButtonDisabledOpacity">1</sys:Double>
    <sys:Double x:Key="SettingsButtonDisabledOpacity">1</sys:Double>
    <sys:Double x:Key="TextSelectionOpacity">1</sys:Double>
    <Visibility x:Key="AeroDecorationVisibility">Visible</Visibility>
    <Visibility x:Key="LegacyDecorationVisibility">Collapsed</Visibility>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15191C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#191D1F"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#414B51"/>
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#171B1D"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D5E4ED"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9BDC9"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#96ACBA"/>
    <SolidColorBrush x:Key="EventLevelForegroundBrush" Color="#FF9E9E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#79CCFF"/>
    <SolidColorBrush x:Key="AeroLabelBrush" Color="#A4D2EF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4B606D"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#234C65"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#4C7B98"/>
