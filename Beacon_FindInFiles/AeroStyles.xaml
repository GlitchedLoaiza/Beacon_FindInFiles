    <LinearGradientBrush x:Key="AeroProgressFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C7F6A0" Offset="0"/>
        <GradientStop Color="#8CE65A" Offset="0.12"/>
        <GradientStop Color="#5ED32C" Offset="0.46"/>
        <GradientStop Color="#23A91C" Offset="0.5"/>
        <GradientStop Color="#38C524" Offset="0.88"/>
        <GradientStop Color="#7EE446" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroProgressShineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.2"/>
        <GradientStop Color="#BFFFFFFF" Offset="0.5"/>
        <GradientStop Color="#20FFFFFF" Offset="0.8"/>
