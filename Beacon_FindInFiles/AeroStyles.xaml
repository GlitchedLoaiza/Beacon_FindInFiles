    <SolidColorBrush x:Key="TextSelectionForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarDividerBrush" Color="#28556D"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#304653"/>
    <SolidColorBrush x:Key="AeroInsetBrush" Color="#101619"/>
    <SolidColorBrush x:Key="AeroDisabledForegroundBrush" Color="#899DA9"/>
    <SolidColorBrush x:Key="ActionButtonForegroundBrush" Color="#D5E4ED"/>
    <SolidColorBrush x:Key="ActionButtonDisabledForegroundBrush" Color="#899DA9"/>
    <SolidColorBrush x:Key="ActionButtonBorderBrush" Color="#54616A"/>
    <SolidColorBrush x:Key="ActionButtonFocusBrush" Color="#79CCFF"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#D5E4ED"/>
    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="#899DA9"/>

    <SolidColorBrush x:Key="AeroProgressBorderBrush" Color="#527180"/>
    <SolidColorBrush x:Key="AeroProgressFillBorderBrush" Color="#357C2B"/>
