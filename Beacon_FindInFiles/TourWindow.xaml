<Window x:Class="Beacon.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon welcome tour" Width="390" SizeToContent="Height" MaxHeight="520" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border x:Name="TourCard" CornerRadius="6" Padding="16" Background="{DynamicResource CardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TourProgress_txt" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="TourTitle_txt" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                <TextBlock x:Name="TourBody_txt" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
            <TextBlock x:Name="TourReminder_txt" Grid.Row="2" Text="Optional at every step. No searches or exports are started automatically." TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ExitTour_btn" Content="Not now" MinWidth="0" Padding="8,4" Margin="0,0,6,0" Click="ExitTour"/>
                <Button x:Name="BackTour_btn" Content="Back" MinWidth="0" Padding="8,4" Margin="0,0,6,0" Click="PreviousStep"/>
                <Button x:Name="NextTour_btn" Content="Start tour" MinWidth="0" Padding="8,4" Margin="0" Click="NextStep"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
