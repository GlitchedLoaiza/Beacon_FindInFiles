    <Compile Include="../../Beacon_FindInFiles/RegexHelpContent.vb" Link="Production/RegexHelpContent.vb" />
    <Compile Include="../../Beacon_FindInFiles/HelpWindow.xaml.vb" Link="HelpWindow.xaml.vb" />
    <Page Include="../../Beacon_FindInFiles/HelpWindow.xaml" Link="HelpWindow.xaml" />
    <Page Include="../../Beacon_FindInFiles/SettingsStyles.xaml" Link="SettingsStyles.xaml" />
    <Compile Include="../../Beacon_FindInFiles/UtcDateTimePicker.xaml.vb" Link="UtcDateTimePicker.xaml.vb" />
    <Page Include="../../Beacon_FindInFiles/UtcDateTimePicker.xaml" Link="UtcDateTimePicker.xaml" />
    <Compile Include="../../Beacon_FindInFiles/SeveritySelector.xaml.vb" Link="SeveritySelector.xaml.vb" />
    <Page Include="../../Beacon_FindInFiles/SeveritySelector.xaml" Link="SeveritySelector.xaml" />
    <Resource Include="../../Beacon_FindInFiles/beacon_no_bg.png" Link="beacon_no_bg.png" />
