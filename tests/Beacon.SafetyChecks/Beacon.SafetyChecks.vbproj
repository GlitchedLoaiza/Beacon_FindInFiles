    <Compile Include="../../Beacon_FindInFiles/SevenZipHelper.vb" Link="Production/SevenZipHelper.vb" />
    <Page Include="../../Beacon_FindInFiles/MainWindow.xaml" Link="MainWindow.xaml" />
    <Compile Include="../../Beacon_FindInFiles/SplashWindow.xaml.vb" Link="SplashWindow.xaml.vb" />
