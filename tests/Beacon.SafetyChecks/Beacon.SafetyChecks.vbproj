    <Compile Include="../../Beacon_FindInFiles/SearchQuery.vb" Link="Production/SearchQuery.vb" />
    <Compile Include="../../Beacon_FindInFiles/SearchResults.vb" Link="Production/SearchResults.vb" />
    <Compile Include="../../Beacon_FindInFiles/StructuredSearchResult.vb" Link="Production/StructuredSearchResult.vb" />
    <Compile Include="../../Beacon_FindInFiles/SourceSearchResult.vb" Link="Production/SourceSearchResult.vb" />
    <Compile Include="../../Beacon_FindInFiles/SourceSearchService.vb" Link="Production/SourceSearchService.vb" />
    <Compile Include="../../Beacon_FindInFiles/HarSearchService.vb" Link="Production/HarSearchService.vb" />
    <Compile Include="../../Beacon_FindInFiles/EvtxSearchService.vb" Link="Production/EvtxSearchService.vb" />
